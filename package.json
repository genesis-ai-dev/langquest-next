{
  "name": "langquest-next",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "help": "node scripts/commands.mjs",
    "dev": "node scripts/local-db.mjs dev",
    "app": "npm run start -w mobile -- --dev-client",
    "web:dev": "npm run dev -w web",
    "db:start": "node scripts/local-db.mjs start",
    "db:stop": "supabase stop",
    "db:reset": "node scripts/local-db.mjs reset",
    "guardrails": "scripts/guardrails.sh",
    "typecheck": "tsc -p packages/core --noEmit && tsc -p packages/sync --noEmit && tsc -p packages/v2-import --noEmit && tsc -p e2e && tsc -p scripts/fleet && tsc -p apps/web/worker && npm run email:typecheck && tsc -p tsconfig.listening-demo.json && tsc -p apps/mobile --noEmit",
    "lint": "eslint --max-warnings=0 apps/mobile/App.tsx apps/mobile/src packages/core/src packages/sync/src",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:integration": "node scripts/with-local-keys.mjs vitest run packages/sync/test/integration.test.ts",
    "test:old-sync": "node scripts/old-sync-tests.mjs",
    "db:test": "node scripts/db-test.mjs",
    "test:web-smoke": "bash -c \"source e2e/env.sh && playwright test -c e2e/web-smoke.config.ts\"",
    "test:ui:web": "playwright test -c e2e/ui.config.ts",
    "test:ui:phone": "node scripts/maestro-ui.mjs",
    "test:ui:build": "node scripts/maestro-build.mjs",
    "test:mutation": "stryker run",
    "server-calls": "node scripts/server-calls.mjs",
    "ship": "npm run ship -w mobile --",
    "db:check": "scripts/db-check.sh",
    "db:apply": "supabase db push --linked",
    "web:deploy": "npm run build -w web && node scripts/cloudflare-deploy.mjs apps/web/wrangler.jsonc",
    "web:deploy:preview": "npm run build:preview -w web && node scripts/cloudflare-deploy.mjs apps/web/wrangler.jsonc preview",
    "email:deploy": "npm run email:typecheck && node scripts/cloudflare-deploy.mjs apps/invite-email/wrangler.jsonc",
    "email:deploy:preview": "npm run email:typecheck && node scripts/cloudflare-deploy.mjs apps/invite-email/wrangler.jsonc preview",
    "r2:buckets": "node scripts/r2-buckets.mjs",
    "github:rules": "node scripts/github-rules.mjs",
    "env:doctor": "scripts/env-doctor.sh",
    "env:check": "node scripts/env-check.mjs",
    "env:update": "scripts/env-update.sh",
    "env:eas": "scripts/eas-env.sh",
    "secrets": "node scripts/secrets.mjs",
    "diag": "tsx scripts/diag.ts",
    "moderation": "tsx scripts/moderation.ts",
    "v2": "node scripts/with-local-keys.mjs tsx server/v2.ts",
    "library:seed": "tsx scripts/library-seed.ts",
    "sample:org": "tsx scripts/sample-org.ts",
    "ui:fixture": "tsx scripts/ui-fixture.ts",
    "languoids": "tsx scripts/languoids.ts",
    "help-audio": "tsx scripts/help-audio.ts",
    "snapshot": "node scripts/with-local-keys.mjs tsx server/snapshotWorker.ts",
    "reconcile": "node scripts/with-local-keys.mjs tsx server/blobReconciler.ts",
    "listening:demo": "tsx --tsconfig tsconfig.listening-demo.json server/listeningDemo.ts",
    "fleet": "node --max-old-space-size=16384 --import tsx scripts/fleet/run.ts",
    "fleet:baselines": "tsx scripts/fleet/baselines.ts",
    "bench:core": "tsx scripts/bench/core.ts",
    "bench:server": "tsx scripts/bench/server.ts",
    "prepare": "git config core.hooksPath .githooks || true",
    "build:push-delivery": "node scripts/build-push-delivery.mjs",
    "build:jobs": "node scripts/build-jobs.mjs",
    "build:explorer": "node scripts/build-explorer-globe.mjs",
    "email:typecheck": "wrangler types -c apps/invite-email/wrangler.jsonc apps/invite-email/worker-configuration.d.ts && tsc -p apps/invite-email"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@dotenvx/dotenvx": "^2.33.0",
    "@eslint-community/eslint-plugin-eslint-comments": "4.8.1",
    "@playwright/test": "^1.63.0",
    "@stryker-mutator/core": "^10.0.0",
    "@stryker-mutator/vitest-runner": "^10.0.0",
    "@types/node": "^26.6.4",
    "@vitest/coverage-v8": "^5.0.4",
    "eas-cli": "^24.10.0",
    "eslint": "10.12.0",
    "eslint-plugin-boundaries": "7.2.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "fast-check": "^4.10.2",
    "supabase": "^2.119.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "8.71.2",
    "vitest": "^5.0.3",
    "wrangler": "^4.147.0"
  },
  "overrides": {
    "eas-cli": {
      "typescript": "$typescript"
    }
  }
}
