{
  "name": "langquest-next",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "prepare": "git config core.hooksPath .githooks || true",
    "test": "vitest run",
    "typecheck": "tsc -p packages/core --noEmit && tsc -p packages/client --noEmit && tsc -p smart-tests && tsc -p apps/web/worker && npm run email:typecheck && tsc -p apps/mobile --noEmit",
    "ship": "npm run ship -w mobile --",
    "db:start": "node scripts/local-db.mjs start",
    "db:stop": "supabase stop",
    "db:reset": "node scripts/local-db.mjs reset",
    "dev:local": "node scripts/local-db.mjs dev",
    "db:check": "scripts/db-check.sh",
    "db:apply": "supabase db push --linked",
    "db:test": "node scripts/db-test.mjs",
    "test:integration": "node scripts/with-local-keys.mjs vitest run packages/client/test/integration.test.ts",
    "snapshot": "node scripts/with-local-keys.mjs tsx server/snapshotWorker.ts",
    "library:seed": "tsx scripts/library-seed.ts",
    "sample:org": "tsx scripts/sample-org.ts",
    "import:v2": "node scripts/with-local-keys.mjs tsx server/importV2.ts",
    "languoids": "tsx scripts/languoids.ts",
    "reconcile": "node scripts/with-local-keys.mjs tsx server/blobReconciler.ts",
    "blobs:copy": "node scripts/with-local-keys.mjs tsx server/copyBlobsToR2.ts",
    "r2:buckets": "node scripts/r2-buckets.mjs",
    "worker:build": "node scripts/build-projection-worker.mjs",
    "explorer:build": "node scripts/build-explorer-globe.mjs",
    "email:typecheck": "wrangler types -c apps/invite-email/wrangler.jsonc apps/invite-email/worker-configuration.d.ts && tsc -p apps/invite-email",
    "email:deploy": "npm run email:typecheck && node scripts/cloudflare-deploy.mjs apps/invite-email/wrangler.jsonc",
    "email:deploy:preview": "npm run email:typecheck && node scripts/cloudflare-deploy.mjs apps/invite-email/wrangler.jsonc preview",
    "env:check": "node scripts/env-check.mjs",
    "env:eas": "scripts/eas-env.sh",
    "app": "npm run start -w mobile -- --dev-client",
    "web:dev": "npm run dev -w web",
    "web:deploy": "npm run build -w web && node scripts/cloudflare-deploy.mjs apps/web/wrangler.jsonc",
    "web:deploy:preview": "npm run build:preview -w web && node scripts/cloudflare-deploy.mjs apps/web/wrangler.jsonc preview",
    "test:web": "bash -c \"source smart-tests/env.sh && playwright test -c smart-tests/web-smoke.config.ts\"",
    "env:update": "scripts/env-update.sh",
    "env:doctor": "scripts/env-doctor.sh",
    "secrets": "node scripts/secrets.mjs",
    "smart": "smart-tests/run.sh",
    "diag": "tsx scripts/diag.ts",
    "moderation": "tsx scripts/moderation.ts"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@dotenvx/dotenvx": "^2.33.0",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.4",
    "eas-cli": "^24.10.0",
    "supabase": "^2.119.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vitest": "^5.0.3",
    "wrangler": "^4.147.0"
  }
}
