#!/bin/bash
# Before a push leaves this machine: the deterministic sync guardrails
# (order-independence and idempotence property tests, the event registry's
# "no shipped event removed" checks, the rest of the unit suite) and the
# typecheck, and the lint that holds what may import what (eslint.config.mjs).
# About 15 s, no keys, no servers. The UI suite runs in CI
# (.github/workflows/guardrails.yml) and before `npm run ship` (docs/testing.md).
# Skip once with `git push --no-verify`; never make that the habit.
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"
echo "pre-push: typecheck + lint + tests"
npm run --silent typecheck
npm run --silent lint
npx vitest run --reporter=dot
