#!/bin/bash
# Before a push leaves this machine: the deterministic sync guardrails
# (order-independence and idempotence property tests, the event registry's
# "no shipped event removed" checks, the rest of the unit suite), the
# typecheck, the lint that holds what may import what (eslint.config.mjs),
# and the push delivery function's bundle against its source. About three
# minutes, no keys, no servers. The UI suite runs in CI
# (.github/workflows/guardrails.yml) and before `npm run ship`;
# `npm run guardrails` runs the CI jobs here (docs/testing.md).
# `npm run guardrails` runs all of these too: when it passed on committed work
# and every commit pushed has the same files (tree), they are not run again
# (scripts/guardrails-passed.mjs, decisions.md 164, amended 2026-11-19).
# Skip once with `git push --no-verify`; never make that the habit.
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"
# What is pushed: one line per ref, `<local ref> <local sha> <remote ref> <remote sha>`.
pushed=""
[ -t 0 ] || pushed=$(cat)
if printf '%s\n' "$pushed" | node scripts/guardrails-passed.mjs covers; then
  exit 0
fi
echo "pre-push: typecheck + lint + tests"
npm run --silent typecheck
npm run --silent lint
# Tests that make a scratch repository must not see the GIT_* this hook is
# given: in a worktree GIT_DIR names the real one, and a fixture's commit
# landed on the branch being pushed (2026-10-23, again 2026-11-05).
(for v in $(compgen -e | grep '^GIT_' || true); do unset "$v"; done; npx vitest run --reporter=dot)
# The pre-commit and post-merge hooks keep the bundle current, but a rebase,
# a commit made with --no-verify, or a branch started before those hooks
# skips them, and the guardrails `checks` job then fails. Only when the
# source it is built from is committed, so the build is of what is pushed.
BUNDLE=supabase/functions/push-delivery/index.ts
if git diff --quiet HEAD -- server scripts/build-push-delivery.mjs "$BUNDLE"; then
  npm run --silent build:push-delivery
  if ! git diff --quiet HEAD -- "$BUNDLE"; then
    echo "pre-push: $BUNDLE was behind its source and is rebuilt now. Commit it and push again." >&2
    exit 1
  fi
fi
