#!/bin/bash
# Before a commit: the push delivery function's bundle follows its source.
# Supabase deploys the committed bundle when a pull request merges
# (server/README.md, Deploying), so a commit that changes what it is built
# from (server/, the build script)
# carries the rebuilt bundle with it. About 0.2 s, and only then.
# It builds from the working tree, so a partly staged change can bundle
# what is not committed; the guardrails check catches that.
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"
BUNDLE=supabase/functions/push-delivery/index.ts
if git diff --cached --name-only | grep -qE '^(server/|scripts/build-push-delivery\.mjs$)'; then
  npm run --silent build:push-delivery
  if ! git diff --quiet -- "$BUNDLE"; then
    git add "$BUNDLE"
    echo "pre-commit: rebuilt $BUNDLE and added it to this commit"
  fi
fi
