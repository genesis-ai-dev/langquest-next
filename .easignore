# Keep the EAS upload to source only. The 424 MB archive that shipped
# node_modules and the nested git worktrees is what broke INSTALL_DEPENDENCIES.
node_modules/
**/node_modules/
.claude/worktrees/
.git/
dist/
build/
apps/mobile/ios/
apps/mobile/android/
**/*.tsbuildinfo
supabase/.branches/
supabase/.temp/

# Keep local credentials and environment files out of cloud build archives.
**/.env
**/.env.*
!**/.env.example
**/.dev.vars*
**/.wrangler/
**/.expo/
**/credentials.json
**/*.p12
**/*.p8
**/*.pem
**/*.key
**/*.jks
**/*.mobileprovision

# npm-style packing drops lockfiles by default; EAS runs `npm ci` at the
# monorepo root, so the lockfile must be in the archive.
!package-lock.json
