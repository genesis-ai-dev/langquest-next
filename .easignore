# Keep the EAS upload to source only. The 424 MB archive that shipped
# node_modules and the nested git worktrees is what broke INSTALL_DEPENDENCIES.
node_modules/
**/node_modules/
.claude/worktrees/
.git/
dist/
build/
apps/mobile/ios/
apps/mobile/android/
**/*.tsbuildinfo
supabase/.branches/
supabase/.temp/

# .easignore replaces .gitignore for uploads, so secrets are listed again.
# Builds get their variables from EAS environments (npm run env:push:eas),
# not from these files; Expo would otherwise read the encrypted values.
.env*
!.env.example

# npm-style packing drops lockfiles by default; EAS runs `npm ci` at the
# monorepo root, so the lockfile must be in the archive.
!package-lock.json
