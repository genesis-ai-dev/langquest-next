{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "mutate": [
    "packages/core/src/**/*.ts",
    "!packages/core/src/**/*.d.ts"
  ],
  "testRunner": "vitest",
  "vitest": {
    "configFile": "vitest.stryker.config.ts",
    "related": false
  },
  "coverageAnalysis": "perTest",
  "incremental": true,
  "incrementalFile": ".stryker-tmp/incremental.json",
  "tempDirName": ".stryker-tmp/sandbox",
  "concurrency": 7,
  "reporters": [
    "clear-text",
    "progress",
    "json",
    "html"
  ],
  "jsonReporter": {
    "fileName": "reports/mutation/mutation.json"
  },
  "htmlReporter": {
    "fileName": "reports/mutation/index.html"
  },
  "disableTypeChecks": "packages/core/src/**/*.ts",
  "timeoutMS": 10000,
  "ignorePatterns": [
    ".claude",
    ".agents",
    ".hermes",
    ".git",
    "apps",
    "docs",
    "supabase",
    "scripts",
    "e2e",
    "server",
    "library",
    "coverage",
    "reports",
    ".stryker-tmp",
    "packages/sync",
    "packages/v2-import",
    "apps/**",
    "packages/sync/**",
    "packages/v2-import/**"
  ],
  "ignoreStatic": true
}
