{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "lib": ["ES2023", "DOM"],
    "paths": {
      "@langquest-next/core": ["./packages/core/src/index.ts"],
      "@langquest-next/sync": ["./packages/sync/src/index.ts"],
      "@langquest-next/sync/server": ["./packages/sync/src/server.ts"]
    },
    "types": ["node"]
  },
  "include": ["server/listeningDemo.ts"]
}
