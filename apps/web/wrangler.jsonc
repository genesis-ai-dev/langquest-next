{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  // The app's Worker (decision 144): the web app, /api and the job runner.
  // Named langquest-next-dashboard until 2026-10-20, when it served only the
  // reports dashboard; the rename made a new Worker (docs/cloudflare.md).
  "name": "langquest-next",
  "main": "worker/index.ts",
  "account_id": "6a80496d1e59948a9cbaa3c643ba81d7",
  "compatibility_date": "2026-09-29",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  // The app's address (decisions.md 58), on the langquest.org zone in this
  // account.
  "routes": [{ "pattern": "next.langquest.org", "custom_domain": true }],
  "observability": { "enabled": true },
  // Every ten minutes: verse timings asked for LangQuest's own sources
  // (worker/timings.ts), expired device grants, webhook catch-up. Every five:
  // the job tick, which starts the projection pass and the v2 import in the
  // job container (worker/jobs.ts, decisions.md 141; jobsModel.ts JOB_TICK).
  "triggers": { "crons": ["*/10 * * * *", "*/5 * * * *"] },
  // The app's web export (npm run export:web in apps/mobile, decisions.md
  // 57): the page, its bundles, version.json and _headers. Only /api/* and
  // /connect (the access-token page, agent/connectPage.ts) reach the Worker
  // first; every other path the page does not have is
  // the page (single-page app). Its source maps are written elsewhere and
  // never served. The ops dashboard's paths (worker/ops.ts) go to its own
  // Worker through the OPS binding below.
  "assets": {
    "directory": "../mobile/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/connect", "/r/*", "/ops-dashboard", "/ops-dashboard/*", "/ops/api/*"]
  },
  // Public settings (docs/environments.md). The project ref must match
  // [remotes.production] in supabase/config.toml (a test checks it). Local
  // development overrides it from .dev.vars (npm run web:dev writes it).
  // The anon key is the public one every app build carries; the connect
  // page signs in with it.
  "vars": {
    "SUPABASE_URL": "https://xymxnebdwtbkfxlbylch.supabase.co",
    // This Worker's own address, where the v2 import's job puts files.
    "API_URL": "https://next.langquest.org",
    // The v2 import runs from the job tick only while this is "true"
    // (docs/v2-import.md: Caleb's go-ahead, given 2026-10-14 as the GitHub
    // variable it replaces), with this many files copied at once.
    "V2_IMPORT_ENABLED": "true",
    "V2_IMPORT_CONCURRENCY": "64",
    "SUPABASE_ANON_KEY": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6Inh5bXhuZWJkd3Ria2Z4bGJ5bGNoIiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODk0OTE1NDYsImV4cCI6MjEwNTA2NzU0Nn0.25nzSvDd07448L-jjQeVUjJ3UIUE-KlRJkUFWkmNz50"
  },
  // Set on the Worker by `npm run secrets -- production`, never at deploy;
  // a deploy fails while one is missing.
  "secrets": { "required": ["SUPABASE_SERVICE_ROLE_KEY"] },
  // One per organization (decision 44): reports and recent folds in memory,
  // a rebuildable cache of them in its own SQLite. JobRunner (worker/jobs.ts,
  // decision 141): one per server job, the object that starts the job's
  // container from the cron and keeps two runs from overlapping.
  "durable_objects": {
    "bindings": [
      { "name": "ORG_SNAPSHOTS", "class_name": "OrgSnapshot" },
      { "name": "JOBS", "class_name": "JobRunner" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["OrgSnapshot"] },
    { "tag": "v2", "new_sqlite_classes": ["JobRunner"] }
  ],
  // The job runner's container (docs/server-jobs.md): the image is built
  // from jobs/Dockerfile at deploy, on Workers Builds as on a laptop, around
  // the bundles scripts/build-jobs.mjs writes. One instance per job (the
  // projection pass, the v2 import), each run alone by its object.
  // standard-1 is 4 GiB, for Santhali's 850 MB fold (decision 103). ENAM keeps
  // them beside the database and R2 (eastern North America, docs/cloudflare.md):
  // unpinned they started near the cron, in Mumbai. A deploy's rollout leaves
  // a run alone for its first 90 minutes (rollout_active_grace_period), then
  // sends SIGTERM and allows 15 more, so the nightly whole v2 read (40 to 70
  // minutes) finishes instead of starting over at every evening merge.
  "containers": [
    { "class_name": "JobRunner", "image": "./jobs/Dockerfile", "instance_type": "standard-1", "max_instances": 2, "constraints": { "regions": ["ENAM"] }, "rollout_active_grace_period": 5400 }
  ],
  // The ops dashboard (worker/ops.ts, docs/admin.md, decisions.md 159): its
  // own Worker, with no address of its own, reached only through this
  // binding, so its read tokens never sit on this one. Production only: the
  // preview stack has no database of its own for it to read yet.
  "services": [{ "binding": "OPS", "service": "langquest-next-admin" }],
  // Recordings and guide media (worker/blobs.ts, decisions.md 69). Private:
  // no public access and no r2.dev address; everything goes through
  // /api/blobs. Created by scripts/r2-buckets.mjs; `wrangler dev` keeps a
  // local copy in .wrangler/state.
  "r2_buckets": [{ "binding": "BLOBS", "bucket_name": "langquest-next-blobs" }],
  // Anyone may ask for a device code (agent/http.ts); per address, 20 a minute.
  "ratelimits": [
    { "name": "DEVICE_RATE_LIMIT", "namespace_id": "7001", "simple": { "limit": 20, "period": 60 } },
    // Review links (agent/links.ts): a whole WhatsApp group may share one address.
    { "name": "LINK_RATE_LIMIT", "namespace_id": "7003", "simple": { "limit": 300, "period": 60 } }
  ],
  // The preview stack (docs/environments.md): langquest-next-preview,
  // deployed from develop. Vars, secrets and bindings are not inherited, so
  // they are repeated here. Add "vars": { "SUPABASE_URL": ... } with the
  // preview branch's ref once [remotes.preview] names it.
  "env": {
    "preview": {
      "routes": [{ "pattern": "next-preview.langquest.org", "custom_domain": true }],
      // The preview app build's public key (apps/mobile/.env.preview).
      // Preview never imports from v2: it has no v2 keys.
      "vars": { "API_URL": "https://next-preview.langquest.org", "V2_IMPORT_ENABLED": "false", "V2_IMPORT_CONCURRENCY": "8", "SUPABASE_ANON_KEY": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6Inh5bXhuZWJkd3Ria2Z4bGJ5bGNoIiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODk0OTE1NDYsImV4cCI6MjEwNTA2NzU0Nn0.25nzSvDd07448L-jjQeVUjJ3UIUE-KlRJkUFWkmNz50" },
      "secrets": { "required": ["SUPABASE_SERVICE_ROLE_KEY"] },
      "durable_objects": {
        "bindings": [
          { "name": "ORG_SNAPSHOTS", "class_name": "OrgSnapshot" },
          { "name": "JOBS", "class_name": "JobRunner" }
        ]
      },
      "containers": [
        { "class_name": "JobRunner", "image": "./jobs/Dockerfile", "instance_type": "standard-1", "max_instances": 2, "constraints": { "regions": ["ENAM"] }, "rollout_active_grace_period": 5400 }
      ],
      "r2_buckets": [{ "binding": "BLOBS", "bucket_name": "langquest-next-blobs-preview" }],
      "ratelimits": [
        { "name": "DEVICE_RATE_LIMIT", "namespace_id": "7002", "simple": { "limit": 20, "period": 60 } },
        { "name": "LINK_RATE_LIMIT", "namespace_id": "7004", "simple": { "limit": 300, "period": 60 } }
      ]
    }
  }
}
