{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "langquest-next-dashboard",
  "main": "worker/index.ts",
  "account_id": "6a80496d1e59948a9cbaa3c643ba81d7",
  "compatibility_date": "2026-09-29",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  // The app's address (decisions.md 58), on the langquest.org zone in this
  // account.
  "routes": [{ "pattern": "next.langquest.org", "custom_domain": true }],
  "observability": { "enabled": true },
  // Publishes verse timings asked for LangQuest's own sources (worker/timings.ts).
  "triggers": { "crons": ["*/10 * * * *"] },
  // The app's web export (npm run export:web in apps/mobile, decisions.md
  // 57): the page, its bundles, version.json and _headers. Only /api/* and
  // /connect (the access-token page, agent/connectPage.ts) reach the Worker
  // first; every other path the page does not have is
  // the page (single-page app). Its source maps are written elsewhere and
  // never served.
  "assets": {
    "directory": "../mobile/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/connect"]
  },
  // Public settings (docs/environments.md). The project ref must match
  // [remotes.production] in supabase/config.toml (a test checks it). Local
  // development overrides it from .dev.vars (npm run web:dev writes it).
  // The anon key is the public one every app build carries; the connect
  // page signs in with it.
  "vars": {
    "SUPABASE_URL": "https://xymxnebdwtbkfxlbylch.supabase.co",
    "SUPABASE_ANON_KEY": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6Inh5bXhuZWJkd3Ria2Z4bGJ5bGNoIiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODk0OTE1NDYsImV4cCI6MjEwNTA2NzU0Nn0.25nzSvDd07448L-jjQeVUjJ3UIUE-KlRJkUFWkmNz50"
  },
  // Set on the Worker by `npm run secrets -- production`, never at deploy;
  // a deploy fails while one is missing.
  "secrets": { "required": ["SUPABASE_SERVICE_ROLE_KEY"] },
  // One per organization (decision 44): reports and recent folds in memory,
  // a rebuildable cache of them in its own SQLite.
  "durable_objects": {
    "bindings": [{ "name": "ORG_SNAPSHOTS", "class_name": "OrgSnapshot" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["OrgSnapshot"] }],
  // Recordings and guide media (worker/blobs.ts, decisions.md 69). Private:
  // no public access and no r2.dev address; everything goes through
  // /api/blobs. Created by scripts/r2-buckets.mjs; `wrangler dev` keeps a
  // local copy in .wrangler/state.
  "r2_buckets": [{ "binding": "BLOBS", "bucket_name": "langquest-next-blobs" }],
  // Anyone may ask for a device code (agent/http.ts); per address, 20 a minute.
  "ratelimits": [{ "name": "DEVICE_RATE_LIMIT", "namespace_id": "7001", "simple": { "limit": 20, "period": 60 } }],
  // The preview stack (docs/environments.md): langquest-next-dashboard-preview,
  // deployed from develop. Vars, secrets and bindings are not inherited, so
  // they are repeated here. Add "vars": { "SUPABASE_URL": ... } with the
  // preview branch's ref once [remotes.preview] names it.
  "env": {
    "preview": {
      "routes": [{ "pattern": "next-preview.langquest.org", "custom_domain": true }],
      // The preview app build's public key (apps/mobile/.env.preview).
      "vars": { "SUPABASE_ANON_KEY": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6Inh5bXhuZWJkd3Ria2Z4bGJ5bGNoIiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODk0OTE1NDYsImV4cCI6MjEwNTA2NzU0Nn0.25nzSvDd07448L-jjQeVUjJ3UIUE-KlRJkUFWkmNz50" },
      "secrets": { "required": ["SUPABASE_SERVICE_ROLE_KEY"] },
      "durable_objects": {
        "bindings": [{ "name": "ORG_SNAPSHOTS", "class_name": "OrgSnapshot" }]
      },
      "r2_buckets": [{ "binding": "BLOBS", "bucket_name": "langquest-next-blobs-preview" }],
      "ratelimits": [{ "name": "DEVICE_RATE_LIMIT", "namespace_id": "7002", "simple": { "limit": 20, "period": 60 } }]
    }
  }
}
