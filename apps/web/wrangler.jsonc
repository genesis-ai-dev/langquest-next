{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "langquest-dashboard",
  "main": "worker/index.ts",
  "account_id": "6a80496d1e59948a9cbaa3c643ba81d7",
  "compatibility_date": "2026-09-29",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "observability": { "enabled": true },
  // The built page; only /api/* reaches the Worker first.
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  // Local development reads .dev.vars (npm run web:dev writes it).
  // Every key here comes from apps/web/.env.production at deploy.
  "secrets": { "required": ["SUPABASE_URL", "SUPABASE_SERVICE_ROLE_KEY"] },
  // One per organization (decision 44), holding its folded state in memory.
  "durable_objects": {
    "bindings": [{ "name": "ORG_SNAPSHOTS", "class_name": "OrgSnapshot" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["OrgSnapshot"] }],
  // The preview stack (docs/environments.md): langquest-dashboard-preview,
  // deployed from develop with apps/web/.env.preview. Secrets and bindings
  // are not inherited, so they are repeated here.
  "env": {
    "preview": {
      "secrets": { "required": ["SUPABASE_URL", "SUPABASE_SERVICE_ROLE_KEY"] },
      "durable_objects": {
        "bindings": [{ "name": "ORG_SNAPSHOTS", "class_name": "OrgSnapshot" }]
      }
    }
  }
}
