# Names only. Real values live in the encrypted files beside this one:
#   .env.development   local Supabase (read by npm start / ios / android)
#   .env.preview       hosted, pushed to the EAS "preview" environment
#   .env.production    hosted, pushed to the EAS "production" environment
# Set a value:   npm run env:set -- KEY value -f apps/mobile/.env.<env>   (from the repo root)
# Personal overrides (your dev login) go in .env.development.local, which git ignores.
# EXPO_PUBLIC_* values are inlined into the app bundle: never put a real secret here.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
EXPO_PUBLIC_DEV_EMAIL=
EXPO_PUBLIC_DEV_PASSWORD=
# Optional override for the Jonah source audio pilot (public R2 base URL).
EXPO_PUBLIC_SOURCE_AUDIO_BASE_URL=
EXPO_PUBLIC_PERSONA_EMAILS=
EXPO_PUBLIC_ORG_ID=
EXPO_PUBLIC_PROJECT_ID=
