# Names only. Real values live in the encrypted files beside this one:
#   .env.development   local Supabase (read by npm start / ios / android)
#   .env.preview       hosted, pushed to the EAS "preview" environment
#   .env.production    hosted, pushed to the EAS "production" environment
# Change a value:  npm run env:update -- <env> KEY   (from the repo root; asks for the value, commits, syncs EAS)
# Personal overrides (your dev login) go in .env.development.local, which git ignores.
# EXPO_PUBLIC_* values are inlined into the app bundle: never put a real secret here.
# The web app is this app's web export (decisions.md 58), built from these same
# files, so it gets them too. Redeploy it (npm run web:deploy) after changing them.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
# The Worker serving reports (decision 44). The web build uses its own address; a phone without it shows only what it folds itself.
EXPO_PUBLIC_API_URL=
# The app's https address for the links it makes (invites, sign-in keys); a phone without it uses langquestnext:// links.
EXPO_PUBLIC_APP_URL=
# For local testing: your dev login (its password is also the personas'), and the testers
# who may switch personas in a build that is not a dev build (comma separated).
EXPO_PUBLIC_DEV_EMAIL=
EXPO_PUBLIC_DEV_PASSWORD=
EXPO_PUBLIC_PERSONA_EMAILS=
