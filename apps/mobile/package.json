{
  "name": "mobile",
  "version": "1.0.0",
  "main": "index.ts",
  "dependencies": {
    "@expo/metro-runtime": "~57.0.16",
    "@langquest-next/client": "*",
    "@langquest-next/core": "*",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/native": "^7.4.1",
    "@react-navigation/native-stack": "^7.19.1",
    "@supabase/supabase-js": "^2.116.0",
    "expo": "~57.0.22",
    "expo-audio": "~57.0.5",
    "expo-camera": "~57.0.5",
    "expo-crypto": "~57.0.3",
    "expo-dev-client": "~57.0.19",
    "expo-file-system": "~57.0.7",
    "expo-notifications": "~57.0.19",
    "expo-sqlite": "~57.0.3",
    "expo-status-bar": "~57.0.1",
    "expo-updates": "~57.0.22",
    "lucide-react-native": "^1.46.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-qrcode-svg": "^6.3.24",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-url-polyfill": "^4.0.0",
    "react-native-web": "^0.21.2"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "dotenvx run -f .env.development.local -f .env.development -fk ../../.env.keys --ignore=MISSING_ENV_FILE --strict -e EXPO_NO_DOTENV=1 -- expo start",
    "start:remote": "dotenvx run -f .env.preview -fk ../../.env.keys --strict -e EXPO_NO_DOTENV=1 -- expo start --dev-client",
    "sim:build": "eas build --profile simulator --platform ios",
    "sim:install": "eas build:run --profile simulator --platform ios --latest",
    "android": "dotenvx run -f .env.development.local -f .env.development -fk ../../.env.keys --ignore=MISSING_ENV_FILE --strict -e EXPO_NO_DOTENV=1 -- expo run:android",
    "android:build": "eas build --profile preview --platform android",
    "android:install": "eas build:run --profile preview --platform android --latest",
    "android:release": "dotenvx run -f .env.preview -fk ../../.env.keys --strict -e EXPO_NO_DOTENV=1 -- expo run:android --variant release --device",
    "ios": "dotenvx run -f .env.development.local -f .env.development -fk ../../.env.keys --ignore=MISSING_ENV_FILE --strict -e EXPO_NO_DOTENV=1 -- expo run:ios",
    "web": "dotenvx run -f .env.development.local -f .env.development -fk ../../.env.keys --ignore=MISSING_ENV_FILE --strict -e EXPO_NO_DOTENV=1 -- expo start --web",
    "typecheck": "tsc --noEmit",
    "ship": "npm run typecheck && eas update --branch preview --environment preview",
    "ship:prod": "npm run typecheck && eas update --branch production --environment production",
    "ship:native": "eas build --profile preview --platform ios",
    "ship:native:prod": "eas build --profile production --platform ios",
    "ship:check": "eas fingerprint:compare",
    "ship:status": "eas update:list --branch preview --limit 5"
  },
  "private": true
}
