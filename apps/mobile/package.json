    "expo-camera": "~58.0.14",
    "expo-crypto": "~58.0.8",
    "expo-dev-client": "~58.0.18",
    "expo-document-picker": "~58.0.4",
    "expo-file-system": "~58.0.13",
    "expo-keep-awake": "~58.0.3",
    "expo-localization": "~58.0.5",
    "expo-network": "~58.0.4",
    "expo-notifications": "~58.1.8",
    "expo-screen-orientation": "~58.0.4",
    "expo-secure-store": "~58.0.2",
    "expo-sqlite": "~58.0.15",
    "expo-status-bar": "~58.0.4",
    "expo-updates": "~58.0.21",
    "html-to-image": "1.11.13",
    "i18n-iso-countries": "^7.14.0",
    "i18next": "^26.7.2",
    "lucide-react-native": "^1.70.0",
    "onnxruntime-web": "1.29.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-i18next": "^17.1.13",
    "react-native": "0.88.1",
    "react-native-qrcode-svg": "^6.3.54",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "15.16.0",
    "react-native-url-polyfill": "^4.0.0",
    "react-native-view-shot": "6.1.1",
    "react-native-web": "~0.21.4",
    "topojson-client": "^3.1.0",
    "world-atlas": "^2.0.2"
  },
  "devDependencies": {
    "@types/d3-geo": "^3.1.1",
    "@types/react": "~19.3.0",
    "@types/topojson-client": "^3.1.5",
    "@types/topojson-specification": "^1.0.5",
    "typescript": "npm:@typescript/typescript6@~6.0.2"
  },
  "scripts": {
    "start": "node scripts/with-env.mjs development node scripts/with-adb-reverse.mjs expo start",
    "start:remote": "node scripts/with-env.mjs preview expo start --dev-client",
    "sim:build": "eas build --profile simulator --platform ios",
    "sim:install": "eas build:run --profile simulator --platform ios --latest",
    "android": "node scripts/with-env.mjs development node scripts/with-adb-reverse.mjs expo run:android",
    "android:build": "eas build --profile preview --platform android",
    "android:install": "eas build:run --profile preview --platform android --latest",
    "android:release": "node scripts/with-env.mjs preview expo run:android --variant release --device",
    "ios": "node scripts/with-env.mjs development expo run:ios",
    "web": "node scripts/with-env.mjs development expo start --web",
    "export:web": "node scripts/export-web.mjs",
    "typecheck": "tsc --noEmit",
    "ship": "node scripts/ship.mjs",
    "eas-build-pre-install": "node scripts/store-build-guard.mjs"
  },
  "private": true,
  "expo": {
    "install": {
      "exclude": [
        "typescript"
      ]
    },
    "autolinking": {
      "ios": {
        "exclude": [
          "expo-alternate-app-icons",
          "expo-document-picker"
        ]
      }
    }
  }
