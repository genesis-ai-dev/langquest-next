  "version": "1.0.0",
  "main": "index.ts",
  "dependencies": {
    "@expo/metro-runtime": "~58.0.17",
    "@langquest-next/core": "*",
    "@langquest-next/sync": "*",
    "@noble/ciphers": "1.3.0",
    "@noble/curves": "1.9.7",
    "@noble/hashes": "1.8.0",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/native": "^7.5.1",
    "@react-navigation/native-stack": "^7.21.0",
    "@supabase/supabase-js": "^2.119.0",
    "d3-geo": "^3.1.2",
    "expo": "~58.0.23",
    "expo-alternate-app-icons": "8.0.0",
    "expo-application": "~58.1.2",
