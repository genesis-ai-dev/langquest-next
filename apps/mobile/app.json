{
  "expo": {
    "name": "LangQuest Next",
    "slug": "langquest-next",
    "version": "1.0.0",
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "updates": {
      "url": "https://u.expo.dev/582d3757-4245-419a-9087-e269e3bf4c4d",
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    },
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.frontierrnd.langquestnext",
      "buildNumber": "4",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "LangQuest records your voice to translate passages.",
        "ITSAppUsesNonExemptEncryption": false,
        "UISupportedInterfaceOrientations": [
          "UIInterfaceOrientationPortrait",
          "UIInterfaceOrientationPortraitUpsideDown"
        ],
        "UISupportedInterfaceOrientations~ipad": [
          "UIInterfaceOrientationPortrait",
          "UIInterfaceOrientationPortraitUpsideDown",
          "UIInterfaceOrientationLandscapeLeft",
          "UIInterfaceOrientationLandscapeRight"
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#000000",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.frontierrnd.langquestnext",
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "next.langquest.org",
              "pathPrefix": "/invite"
            },
            {
              "scheme": "https",
              "host": "next.langquest.org",
              "pathPrefix": "/signin"
            },
            {
              "scheme": "https",
              "host": "next-preview.langquest.org",
              "pathPrefix": "/invite"
            },
            {
              "scheme": "https",
              "host": "next-preview.langquest.org",
              "pathPrefix": "/signin"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "output": "single",
      "name": "LangQuest",
      "themeColor": "#6B48C8",
      "backgroundColor": "#F4F2FA"
    },
    "plugins": [
      "expo-sqlite",
      [
        "expo-audio",
        {
          "microphonePermission": "LangQuest records your voice to translate passages.",
          "enableBackgroundPlayback": false
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "LangQuest uses the camera to scan invite QR codes."
        }
      ],
      "expo-notifications",
      "./plugins/withSceneLifecycle",
      [
        "expo-localization",
        {
          "supportedLocales": [
            "en",
            "es",
            "pt-BR",
            "fr",
            "ar",
            "sw",
            "ha",
            "am",
            "hi",
            "bn",
            "ne",
            "id",
            "zh-Hans",
            "th",
            "my"
          ]
        }
      ]
    ],
    "scheme": "langquestnext",
    "extra": {
      "eas": {
        "projectId": "582d3757-4245-419a-9087-e269e3bf4c4d"
      }
    },
    "locales": {
      "es": "./locales/es.json",
      "pt-BR": "./locales/pt-BR.json",
      "fr": "./locales/fr.json",
      "ar": "./locales/ar.json",
      "sw": "./locales/sw.json",
      "ha": "./locales/ha.json",
      "am": "./locales/am.json",
      "hi": "./locales/hi.json",
      "bn": "./locales/bn.json",
      "ne": "./locales/ne.json",
      "id": "./locales/id.json",
      "zh-Hans": "./locales/zh-Hans.json",
      "th": "./locales/th.json",
      "my": "./locales/my.json"
    }
  }
}
