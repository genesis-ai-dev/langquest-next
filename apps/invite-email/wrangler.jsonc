{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "langquest-invite-email",
  "main": "src/index.ts",
  "account_id": "6a80496d1e59948a9cbaa3c643ba81d7",
  "compatibility_date": "2026-09-17",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "observability": { "enabled": true },
  // Every key here comes from apps/invite-email/.env.production at deploy.
  "secrets": { "required": ["INVITE_FROM", "INVITE_RELAY_SECRET"] },
  "send_email": [{
    "name": "EMAIL",
    "allowed_sender_addresses": ["invites@frontierrnd.com"]
  }],
  "durable_objects": {
    "bindings": [{ "name": "DELIVERIES", "class_name": "InviteDelivery" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["InviteDelivery"] }],
  // The preview stack (docs/environments.md): langquest-invite-email-preview,
  // deployed from develop with apps/invite-email/.env.preview. Secrets and
  // bindings are not inherited, so they are repeated here.
  "env": {
    "preview": {
      "secrets": { "required": ["INVITE_FROM", "INVITE_RELAY_SECRET"] },
      "send_email": [{
        "name": "EMAIL",
        "allowed_sender_addresses": ["invites@frontierrnd.com"]
      }],
      "durable_objects": {
        "bindings": [{ "name": "DELIVERIES", "class_name": "InviteDelivery" }]
      }
    }
  }
}
